# ==============================================================================
# UnOffProxMox-MCP Configuration Environment Template
# Copy this file to .env and fill in your Proxmox credentials.
# NEVER commit your live .env or API secrets to version control!
# ==============================================================================

# Proxmox Host / IP address (FQDN or IP)
PVE_HOST=192.168.1.100

# Proxmox API Port (default is 8006)
PVE_PORT=8006

# Node name (default node where commands target if not specified; default: pve)
PVE_NODE=pve

# ------------------------------------------------------------------------------
# Authentication Method 1: API Token (RECOMMENDED)
# Format for PVE_USER: <user>@<realm>!<token_name>
# Example: root@pam!mcp_token or automation@pve!claude
# ------------------------------------------------------------------------------
PVE_USER=root@pam!mcp_token
PVE_TOKEN_SECRET=00000000-0000-0000-0000-000000000000

# ------------------------------------------------------------------------------
# Authentication Method 2: Username & Password (Optional fallback)
# If PVE_TOKEN_SECRET is left empty, the server will use password authentication.
# PVE_USER=root@pam
# PVE_PASSWORD=your_secure_password
# ------------------------------------------------------------------------------
PVE_PASSWORD=

# SSL Verification (set to false if using self-signed Proxmox certificates)
PVE_VERIFY_SSL=false

# Task Timeout in seconds for waiting on long-running async tasks (clones, builds, backups)
PVE_TASK_TIMEOUT=300

# Safety Guardrail: Comma-separated list of protected VM/LXC IDs that CANNOT be destroyed
PVE_PROTECTED_VMIDS=100,101,200

# Server Transport Mode: 'stdio' (default for CLI / AI IDEs) or 'sse' (HTTP server for network / webhooks)
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
